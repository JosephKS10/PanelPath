# Copy to server/.env for local use (npm run dev / npm run eval). Never commit the real file.
ANTHROPIC_API_KEY=
# Site origins allowed to call the API, comma-separated. Leave empty locally to allow any.
ALLOWED_ORIGINS=
CHAT_MODEL=claude-sonnet-5-5
# Abuse limits: per visitor per minute, per visitor per day, and all visitors per UTC day.
RATE_PER_MINUTE=6
RATE_PER_DAY=40
DAILY_CAP=400
# Set to false to switch the assistant off without redeploying the site.
CHAT_ENABLED=true
PORT=8787
